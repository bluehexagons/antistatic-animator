{
  "name": "antistatic-animator",
  "version": "0.2.0",
  "description": "",
  "homepage": "https://github.com/bluehexagons/antistatic-animator#readme",
  "bugs": {
    "url": "https://github.com/bluehexagons/antistatic-animator/issues"
  },
  "license": "MIT",
  "author": "bluehexagons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehexagons/antistatic-animator.git"
  },
  "type": "commonjs",
  "main": "dist/electron.js",
  "scripts": {
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:main": "esbuild ./src/electron.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/electron.js --external:electron --external:electron-devtools-installer",
    "build:preload": "esbuild ./src/preload.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/preload.js --external:electron",
    "build:renderer": "vite build && node scripts/check-web-csp.js",
    "build:web": "vite build && node scripts/check-web-csp.js",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test:run && npm run build",
    "dev": "vite",
    "host": "vite --host 127.0.0.1",
    "dev:web": "vite",
    "dev:electron": "npm run build:renderer && npm run build:main && npm run build:preload && electron .",
    "preview": "vite preview",
    "preview:web": "vite preview",
    "start": "electron .",
    "watch": "npm run build:main && npm run build:preload && npm run build:renderer -- --watch",
    "dist": "npx @electron/packager . --config=packager.config.js",
    "package": "node scripts/package-release.js",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src scripts vite.config.mts packager.config.js --deny-warnings",
    "lint:fix": "oxlint src scripts vite.config.mts packager.config.js --fix --deny-warnings",
    "format": "oxfmt src scripts index.html package.json vite.config.mts packager.config.js",
    "format:check": "oxfmt --check src scripts index.html package.json vite.config.mts packager.config.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@bluehexagons/easing": "https://codeload.github.com/bluehexagons/easing/tar.gz/refs/tags/v0.5.1",
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "electron": "^44.4.5",
    "electron-devtools-installer": "^4.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,html,json}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
